// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?
  password  String
  role      String   @default("USER") // "USER" | "ADMIN"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rabbits       Rabbit[]
  aliments      Aliment[]
  transactions  Transaction[]
  accouplements Accouplement[]
  notifications NotificationTicket[]
}

model Rabbit {
  id            String    @id @default(cuid())
  userId        String?
  name          String
  identifiant   String    @unique
  race          String
  sexe          String    // "male" | "femelle"
  dateNaissance DateTime
  poids         Float?
  couleur       String?
  statut        String    @default("actif") // "actif" | "vendu" | "decede" | "reproducteur"
  notes         String?
  cageNumero    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user                 User?          @relation(fields: [userId], references: [id])
  // Relations
  accouplementsMale    Accouplement[] @relation("pere")
  accouplementsFemelle Accouplement[] @relation("mere")
  santeLogs            SanteLog[]
  poidsLogs            PoidsLog[]
  lapereaux_biologique Lapereau[]     @relation("mereBiologique")
  lapereaux_adoptive   Lapereau[]     @relation("mereAdoptive")
}

model Accouplement {
  id               String    @id @default(cuid())
  userId           String?
  dateAccouplement DateTime
  pereId           String
  mereId           String
  dateMiseBas      DateTime?  // dateAccouplement + 31 jours
  statut           String    @default("en_cours") // "en_cours" | "mise_bas" | "echec"
  nombreNes        Int?
  nombreVivants    Int?
  dateSevrage      DateTime?
  couleurVulve     String?   // "blanche" | "rose" | "rouge" | "violacee"
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     User?         @relation(fields: [userId], references: [id])
  pere     Rabbit        @relation("pere", fields: [pereId], references: [id])
  mere     Rabbit        @relation("mere", fields: [mereId], references: [id])
  lapereaux Lapereau[]
  taches   TacheElevage[]
}

model Lapereau {
  id                String    @id @default(cuid())
  accouplementId    String
  identifiant       String?
  sexe              String?
  poids             Float?
  statut            String    @default("vivant") // "vivant" | "mort" | "sevre" | "vendu"
  causeDeces        String?   // "presevrage_froid_ecrasement" | "cannibalisme_maternel" | "postsevrage_5sem" | "postsevrage_7sem" | "postsevrage_9sem" | "maladie_fulgurante_vhd" | "autre"
  mereBiologiqueId  String?
  mereAdoptiveId    String?
  dateAdoption      DateTime? // transfert obligatoire dans les 72h
  notes             String?
  createdAt         DateTime  @default(now())

  accouplement   Accouplement @relation(fields: [accouplementId], references: [id])
  mereBiologique Rabbit?      @relation("mereBiologique", fields: [mereBiologiqueId], references: [id])
  mereAdoptive   Rabbit?      @relation("mereAdoptive", fields: [mereAdoptiveId], references: [id])
}

model SanteLog {
  id          String   @id @default(cuid())
  rabbitId    String
  type        String   // "vaccin" | "traitement" | "observation" | "veterinaire"
  description String
  date        DateTime
  prochainRappel    DateTime?
  delaiAttenteJours Int?      // délai d'attente légal en jours (médicaments)
  finDelaiAttente   DateTime? // date calculée de fin du délai d'attente
  veterinaire String?
  cout        Float?
  notes       String?
  createdAt   DateTime @default(now())

  rabbit Rabbit @relation(fields: [rabbitId], references: [id])
}

model PoidsLog {
  id       String   @id @default(cuid())
  rabbitId String
  poids    Float
  date     DateTime
  notes    String?

  rabbit Rabbit @relation(fields: [rabbitId], references: [id])
}

model Aliment {
  id           String   @id @default(cuid())
  userId       String?
  nom          String
  type         String   // "foin" | "granules" | "legumes" | "supplement" | "autre"
  unite        String   @default("kg")  // "kg" | "g" | "L" | "botte"
  stockActuel  Float    @default(0)
  stockMin     Float    @default(5)     // seuil d'alerte
  prixUnitaire Float?
  fournisseur  String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User?                @relation(fields: [userId], references: [id])
  distributions DistributionAliment[]
}

model DistributionAliment {
  id         String   @id @default(cuid())
  alimentId  String
  date       DateTime @default(now())
  quantite   Float
  cageNumero String?
  notes      String?
  createdAt  DateTime @default(now())

  aliment    Aliment  @relation(fields: [alimentId], references: [id])
}

model NotificationTicket {
  id              String   @id @default(cuid())
  userId          String?
  notificationId  String   @unique // ID stable de la notification calculée (ex: "mise_bas_clxxxx")
  type            String   // "mise_bas" | "saillie" | "stock_bas" | ...
  titre           String
  message         String
  priorite        String   // "haute" | "normale" | "basse"
  status          String   @default("resolved") // "resolved" | "reopened"
  resolutionNote  String?
  resolvedAt      DateTime @default(now())
  reopenedAt      DateTime?
  rabbitId        String?
  rabbitName      String?
  alimentNom      String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User?    @relation(fields: [userId], references: [id])

  @@index([notificationId])
  @@index([status])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String?
  type        String   // "depense" | "recette"
  categorie   String   // "alimentation" | "veterinaire" | "equipement" | "vente_lapin" | "vente_viande" | "reproduction" | "autre"
  montant     Float
  date        DateTime
  description String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id])
}

model TacheElevage {
  id             String    @id @default(cuid())
  accouplementId String?
  type           String    // "palpation" | "boite_nid" | "mise_bas" | "sevrage" | "retour_saillie"
  dateEcheance   DateTime
  statut         String    @default("a_faire") // "a_faire" | "fait" | "ignore"
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accouplement   Accouplement? @relation(fields: [accouplementId], references: [id])
}

model ParametresElevage {
  id                 String   @id @default(cuid())
  userId             String?
  rythmeReproduction String   @default("extensif") // "intensif" | "extensif"
  intervalleIntensif Int      @default(42)  // jours post-mise-bas avant retour saillie
  intervalleExtensif Int      @default(21)  // jours post-mise-bas (médiane 18-25j)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
